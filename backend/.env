# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials (subject V.8).

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (see docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://musicroom:musicroom@localhost:5432/musicroom?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS: comma-separated list of allowed origins (mobile app config screen, web build, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Google OAuth (developers.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Facebook OAuth (developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Mail (used for email verification + password reset)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Music Room <no-reply@musicroom.local>"
# When true, verification/reset emails are only printed to the server console
# (handy for local dev / defense without a real SMTP account).
MAIL_DEV_MODE=true

APP_PUBLIC_URL=http://localhost:3000
