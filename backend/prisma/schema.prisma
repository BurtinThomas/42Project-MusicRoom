generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  PAID
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum VoteLicense {
  OPEN
  INVITE_ONLY
  LOCATION_TIME
}

enum EditLicense {
  OPEN
  INVITE_ONLY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum ActionLogPlatform {
  ANDROID
  IOS
  WEB
  UNKNOWN
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String?
  emailVerified          Boolean   @default(false)
  emailVerifyToken       String?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  displayName      String
  publicInfo       Json   @default("{}")
  friendsInfo      Json   @default("{}")
  privateInfo      Json   @default("{}")
  musicPreferences Json   @default("{}")

  subscriptionPlan SubscriptionPlan @default(FREE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities                 SocialIdentity[]
  devices                    Device[]
  actionLogs                 ActionLog[]
  ownedEvents                Event[]             @relation("EventOwner")
  eventInvites               EventInvite[]
  votes                      Vote[]
  ownedPlaylists             Playlist[]          @relation("PlaylistOwner")
  playlistInvites            PlaylistInvite[]
  playlistTracksAdded        PlaylistTrack[]     @relation("PlaylistTrackAddedBy")
  friendshipsFrom            Friendship[]        @relation("FriendshipRequester")
  friendshipsTo              Friendship[]        @relation("FriendshipAddressee")
  refreshTokens              RefreshToken[]
  eventTracksAdded           EventTrack[]        @relation("EventTrackAddedBy")
  controlDelegationsGranted  ControlDelegation[] @relation("DelegationOwner")
  controlDelegationsReceived ControlDelegation[] @relation("DelegationDelegate")
}

model SocialIdentity {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime     @default(now())

  @@unique([provider, providerId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Friendship {
  id          String           @id @default(uuid())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
}

model Device {
  id             String            @id @default(uuid())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  installationId String
  platform       ActionLogPlatform
  model          String
  appVersion     String
  createdAt      DateTime          @default(now())
  lastSeenAt     DateTime          @updatedAt

  actionLogs               ActionLog[]
  delegationsAsOwnerDevice ControlDelegation[]

  @@unique([userId, installationId])
}

model ActionLog {
  id         String            @id @default(uuid())
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  device     Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceId   String?
  platform   ActionLogPlatform
  appVersion String
  action     String
  metadata   Json              @default("{}")
  createdAt  DateTime          @default(now())

  @@index([userId])
  @@index([action])
}

model Event {
  id          String      @id @default(uuid())
  owner       User        @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  name        String
  visibility  Visibility  @default(PUBLIC)
  voteLicense VoteLicense @default(OPEN)

  locationLat     Float?
  locationLng     Float?
  locationRadiusM Int?
  voteWindowStart DateTime?
  voteWindowEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invites EventInvite[]
  tracks  EventTrack[]
  beacon  EventBeacon?
}

model EventBeacon {
  id      String @id @default(uuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String @unique
  uuid    String
  major   Int
  minor   Int

  @@unique([uuid, major, minor])
}

model EventInvite {
  id      String @id @default(uuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([eventId, userId])
}

model Track {
  id          String  @id @default(uuid())
  title       String
  artist      String
  durationMs  Int?
  externalRef String?

  eventTracks    EventTrack[]
  playlistTracks PlaylistTrack[]
}

model EventTrack {
  id        String    @id @default(uuid())
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  track     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId   String
  addedBy   User      @relation("EventTrackAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  addedById String
  score     Int       @default(0)
  playedAt  DateTime?
  createdAt DateTime  @default(now())

  votes Vote[]

  @@unique([eventId, trackId])
  @@index([eventId, score])
}

model Vote {
  id           String     @id @default(uuid())
  eventTrack   EventTrack @relation(fields: [eventTrackId], references: [id], onDelete: Cascade)
  eventTrackId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime   @default(now())

  @@unique([eventTrackId, userId])
}

model Playlist {
  id               String      @id @default(uuid())
  owner            User        @relation("PlaylistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  name             String
  visibility       Visibility  @default(PUBLIC)
  editLicense      EditLicense @default(OPEN)
  requiresPaidPlan Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invites PlaylistInvite[]
  tracks  PlaylistTrack[]
}

model PlaylistInvite {
  id         String   @id @default(uuid())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([playlistId, userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId    String
  position   Int
  addedBy    User     @relation("PlaylistTrackAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  addedById  String
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([playlistId, position])
}

model ControlDelegation {
  id         String    @id @default(uuid())
  owner      User      @relation("DelegationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId   String
  delegate   User      @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)
  delegateId String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([deviceId])
}
